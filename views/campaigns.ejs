<%- include('partials/header', { title: 'Campaign', active: 'campaigns' }) %>

<% if (error) { %><div class="alert"><%= error %></div><% } %>

<% if (excelResult) { %>
  <div class="alert <%= (excelResult.errors.length || excelResult.skippedTotal) ? 'warn' : '' %>">
    Excel diproses: <strong><%= excelResult.added %></strong> penerima
    <% if (excelResult.duplicates) { %>, <strong><%= excelResult.duplicates %></strong> duplikat dilewati<% } %>
    <% if (excelResult.skippedTotal) { %>, <strong><%= excelResult.skippedTotal %></strong> baris terlewat (jadwal lampau/kosong)<% } %>.
    <% if (excelResult.skippedTotal) { %>
      <details><summary>daftar baris terlewat</summary>
        <ul><% excelResult.skipped.forEach(e => { %><li><%= e.message %></li><% }) %></ul>
        <% if (excelResult.skippedTotal > excelResult.skipped.length) { %>
          <div>…dan <%= excelResult.skippedTotal - excelResult.skipped.length %> baris lainnya</div>
        <% } %>
      </details>
    <% } %>
    <% if (excelResult.errors.length) { %>
      <details><summary><%= excelResult.errors.length %> baris dilewati</summary>
        <ul><% excelResult.errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </details>
    <% } %>
  </div>
<% } %>

<% if (!waConnected) { %>
  <div class="alert warn">WhatsApp belum tersambung. <a href="/connect">Pindai QR dulu</a> sebelum mengirim.</div>
<% } %>

<% if (activeId) { %>
  <div class="alert warn">Campaign #<%= activeId %> sedang berjalan. Hanya satu campaign yang bisa berjalan bersamaan. <a href="/campaigns/<%= activeId %>">Lihat</a></div>
<% } %>

<div class="card">
  <div class="card-head"><h2>Campaign Baru</h2></div>
  <form method="POST" action="/campaigns" enctype="multipart/form-data" class="form-grid">
    <label>Nama campaign <input name="name" required placeholder="Promo hari ini"></label>

    <label>Template (opsional)
      <select name="templateId">
        <option value="">— tanpa template —</option>
        <% templates.forEach(t => { %><option value="<%= t.id %>"><%= t.name %> (#<%= t.id %>)</option><% }) %>
      </select>
    </label>

    <label>Isi pesan (kosongkan bila pakai template)
      <textarea name="body" rows="5" placeholder="Halo {nama}, ..."></textarea>
    </label>
    <div class="hint">Variabel: <% timeVars.forEach(([v, d]) => { %><code title="<%= d %>"><%= v %></code> <% }) %><br>Variabel tanggal/jam diisi saat pesan dikirim (jadwal &amp; pengulangan tetap akurat).</div>

    <label>Media lampiran (opsional)
      <input type="file" name="media" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip">
    </label>

    <div class="two-col">
      <label>Penerima
        <select name="selector" id="sel-selector">
          <option value="all">Semua kontak (<%= contactTotal %>)</option>
          <option value="ids">Pilih kontak…</option>
          <option value="tags">Berdasarkan tag…</option>
        </select>
      </label>
      <div></div>
    </div>

    <div id="picker-ids" class="picker hidden">
      <input type="text" id="contact-search" class="picker-search" placeholder="Cari nama / nomor…" autocomplete="off">
      <div class="hint" id="contact-count"></div>
      <div class="picker-list" id="contact-list">
        <% contacts.forEach(c => { %>
          <label class="picker-item">
            <input type="checkbox" class="contact-check" value="<%= c.id %>">
            <span><strong><%= c.name || '(tanpa nama)' %></strong> <code><%= c.phone %></code><% if (c.tags) { %> <span class="muted">· <%= c.tags %></span><% } %></span>
          </label>
        <% }) %>
        <% if (!contacts.length) { %><div class="muted">Belum ada kontak — tambah dulu di menu Kontak.</div><% } %>
      </div>
      <% if (contactTotal > contacts.length) { %>
        <div class="hint">Menampilkan <%= contacts.length %> dari <%= contactTotal %> kontak — saring lewat kotak cari di atas.</div>
      <% } %>
    </div>

    <div id="picker-tags" class="picker hidden">
      <% if (tags.length) { %>
        <div class="picker-list">
          <% tags.forEach(t => { %>
            <label class="picker-item">
              <input type="checkbox" class="tag-check" value="<%= t %>">
              <span><%= t %></span>
            </label>
          <% }) %>
        </div>
      <% } else { %>
        <div class="muted">Belum ada tag — beri tag pada kontak di menu Kontak.</div>
      <% } %>
    </div>

    <input type="hidden" name="selectorValue" id="selector-value" value="">

    <div class="two-col">
      <label>Delay minimal (ms) <input type="number" name="delayMinMs" value="3000" min="500" step="500"></label>
      <label>Delay maksimal (ms) <input type="number" name="delayMaxMs" value="8000" min="500" step="500"></label>
    </div>
    <div class="hint">Delay acak antar pesan untuk mengurangi risiko banned. Disarankan 3000–10000 ms.</div>

    <label>Jadwal kirim (kosongkan untuk kirim manual) <input type="datetime-local" name="scheduledAt"></label>

    <div class="two-col">
      <label>Pengulangan
        <select name="repeatRule" id="sel-repeat">
          <option value="none">Tidak diulang</option>
          <option value="interval">Berulang setiap…</option>
        </select>
      </label>
      <div id="repeat-opts" class="two-col" style="visibility:hidden">
        <label>Setiap <input type="number" name="repeatEvery" value="1" min="1" max="999"></label>
        <label>&nbsp;
          <select name="repeatUnit">
            <option value="minutes">Menit</option>
            <option value="hours" selected>Jam</option>
            <option value="days">Hari</option>
            <option value="weeks">Minggu</option>
          </select>
        </label>
      </div>
    </div>
    <label id="repeat-until-label" style="display:none">Berhenti mengulang pada (opsional)
      <input type="datetime-local" name="repeatUntil">
    </label>
    <div class="hint">Contoh: 1 jam sekali = Setiap 1 <strong>Jam</strong>; sehari sekali = Setiap 1 <strong>Hari</strong>. Setiap siklus pesan dikirim ulang ke daftar penerima yang sama.</div>

    <div class="row-gap">
      <button class="btn primary" name="action" value="draft" formnovalidate>Simpan Draft</button>
      <button class="btn primary" name="action" value="send"<% if (!waConnected) { %> disabled title="WhatsApp belum tersambung — pindai QR dulu"<% } %>>Kirim Sekarang</button>
    </div>
  </form>
</div>

<div class="card">
  <div class="card-head"><h2>Impor Excel — kirim terjadwal per baris</h2></div>
  <form method="POST" action="/campaigns/excel" enctype="multipart/form-data" class="form-grid">
    <label>Nama campaign (opsional) <input name="name" placeholder="Kirim terjadwal Oktober"></label>
    <label>Template (opsional)
      <select name="templateId">
        <option value="">— tanpa template —</option>
        <% templates.forEach(t => { %><option value="<%= t.id %>"><%= t.name %> (#<%= t.id %>)</option><% }) %>
      </select>
    </label>
    <label>Pesan default (dipakai baris yang kolom pesannya kosong)
      <textarea name="body" rows="4" placeholder="Halo {nama}, ... atau {template:3}"></textarea>
    </label>
    <label>File Excel (.xlsx) <input type="file" name="excel" accept=".xlsx" required></label>
    <div class="two-col">
      <label>Delay minimal (ms) <input type="number" name="delayMinMs" value="3000" min="500" step="500"></label>
      <label>Delay maksimal (ms) <input type="number" name="delayMaxMs" value="8000" min="500" step="500"></label>
    </div>
    <div class="row-gap">
      <button class="btn primary">Unggah &amp; Jadwalkan</button>
      <a class="btn ghost" href="/campaigns/excel/template">Unduh template</a>
    </div>
  </form>
  <div class="hint">
    Kolom wajib: <code>jadwal</code> (format <code>30/09/2026 14:30</code>; format AS <code>9/30/2026 14:30</code> juga dikenali) plus <code>nomor</code> atau <code>tag</code>. Opsional: <code>nama</code> <code>pesan</code>.<br>
    Kolom <code>tag</code> (opsional): baris tanpa nomor akan dikirim ke semua kontak dengan tag tersebut — boleh lebih dari satu, pisah koma (contoh <code>vip,pelanggan</code>) — dan boleh dicampur dengan baris nomor biasa. Tag tidak dikenal/tanpa kontak → baris dilewati (tercatat sebagai error).<br>
    Kolom <code>pesan</code> boleh teks bebas atau <code>{template:id}</code> (contoh <code>{template:3}</code>) untuk memakai isi template — boleh juga dicampur teks.<br>
    Prioritas pesan: kolom baris &gt; pesan default (boleh juga <code>{template:id}</code>) &gt; template pilihan di atas.<br>
    Satu nomor boleh muncul berkali-kali dengan jadwal berbeda — tiap jadwal jadi pengiriman terpisah (jadwal identik: baris pertama menang).<br>
    Baris dengan jadwal kosong atau sudah lewat <strong>TIDAK dikirim</strong> — muncul sebagai "baris terlewat" setelah impor.<br>
    Pengiriman mulai otomatis ±1 menit setelah unggah, diurutkan dari jadwal paling awal.
  </div>

  <div class="card-head" style="margin-top:12px"><h2>…atau ambil dari sheet online</h2></div>
  <form method="POST" action="/campaigns/excel/url" class="form-grid">
    <label>Nama campaign (opsional) <input name="name" placeholder="Ambil sheet promo Oktober"></label>
    <label>Template (opsional)
      <select name="templateId">
        <option value="">— tanpa template —</option>
        <% templates.forEach(t => { %><option value="<%= t.id %>"><%= t.name %> (#<%= t.id %>)</option><% }) %>
      </select>
    </label>
    <label>Link Google Sheets / OneDrive / Excel Online
      <input type="url" name="sheetUrl" required placeholder="https://docs.google.com/spreadsheets/d/xxxx/edit">
    </label>
    <label>Pesan default (dipakai baris yang kolom pesannya kosong)
      <textarea name="body" rows="3" placeholder="Halo {nama}, ... atau {template:3}"></textarea>
    </label>
    <div class="two-col">
      <label>Delay minimal (ms) <input type="number" name="delayMinMs" value="3000" min="500" step="500"></label>
      <label>Delay maksimal (ms) <input type="number" name="delayMaxMs" value="8000" min="500" step="500"></label>
    </div>
    <div class="row-gap">
      <button class="btn primary">Ambil &amp; Jadwalkan</button>
    </div>
  </form>
  <div class="hint">
    Sheet harus dibagikan <strong>"Siapa saja yang punya link"</strong> (Bagikan → lihat). Format kolom sama dengan template.<br>
    Kolom <code>tag</code> (opsional): baris tanpa nomor dikirim ke semua kontak dengan tag (boleh lebih dari satu, pisah koma) — ikut ditarik saat <strong>Sinkronkan ulang</strong>.<br>
    Kolom <code>pesan</code> boleh teks bebas atau <code>{template:id}</code>; prioritas: kolom baris &gt; pesan default &gt; template pilihan di atas.<br>
    Satu nomor boleh muncul berkali-kali dengan jadwal berbeda — tiap jadwal pengiriman terpisah.<br>
    Baris jadwal lampau/kosong juga terlewat — termasuk saat tombol <strong>Sinkronkan ulang</strong> dipakai.<br>
    Campaign dari sheet punya tombol <strong>Sinkronkan ulang</strong> di halaman detail untuk menarik baris baru kapan pun (tanpa menghapus yang sudah ada).
  </div>
</div>

<div class="card">
  <div class="card-head"><h2>Semua Campaign (<%= campaigns.length %>)</h2></div>
  <table>
    <thead><tr><th>Nama</th><th>Status</th><th>Total</th><th>Jadwal</th><th>Ulang</th><th></th></tr></thead>
    <tbody>
      <% campaigns.forEach(c => { %>
        <tr>
          <td><strong><%= c.name %></strong></td>
          <td><span class="badge st-<%= c.status %>" data-camp="<%= c.id %>"><%= c.status %></span></td>
          <td><%= c.total %></td>
          <td><%= c.scheduled_at ? new Date(c.scheduled_at).toLocaleString('id-ID') : '-' %></td>
          <td><%= repeatLabel(c) || '-' %></td>
          <td class="right"><a class="btn ghost small" href="/campaigns/<%= c.id %>">Detail</a></td>
        </tr>
      <% }) %>
      <% if (!campaigns.length) { %><tr><td colspan="6" class="muted">Belum ada campaign.</td></tr><% } %>
    </tbody>
  </table>
</div>

<script>
  const selSelector = document.getElementById('sel-selector');
  const pickerIds = document.getElementById('picker-ids');
  const pickerTags = document.getElementById('picker-tags');
  const selectorValue = document.getElementById('selector-value');
  const contactSearch = document.getElementById('contact-search');
  const contactCount = document.getElementById('contact-count');
  const contactChecks = () => [...document.querySelectorAll('.contact-check')];
  const tagChecks = () => [...document.querySelectorAll('.tag-check')];

  const syncPicker = () => {
    const mode = selSelector.value;
    pickerIds.classList.toggle('hidden', mode !== 'ids');
    pickerTags.classList.toggle('hidden', mode !== 'tags');
    selectorValue.value = mode === 'ids'
      ? contactChecks().filter((c) => c.checked).map((c) => c.value).join(',')
      : mode === 'tags'
        ? tagChecks().filter((c) => c.checked).map((c) => c.value).join(',')
        : '';
  };

  const syncContactCount = () => {
    const items = [...document.querySelectorAll('#contact-list .picker-item')];
    const visible = items.filter((el) => !el.classList.contains('hidden')).length;
    const checked = contactChecks().filter((c) => c.checked).length;
    contactCount.textContent = `${checked} dipilih · ${visible} tampil`;
  };

  selSelector.addEventListener('change', syncPicker);

  contactSearch.addEventListener('input', () => {
    const q = contactSearch.value.trim().toLowerCase();
    document.querySelectorAll('#contact-list .picker-item').forEach((el) => {
      const text = el.querySelector('span').textContent.toLowerCase();
      el.classList.toggle('hidden', Boolean(q) && !text.includes(q));
    });
    syncContactCount();
  });

  document.getElementById('contact-list').addEventListener('change', () => { syncPicker(); syncContactCount(); });
  pickerTags.addEventListener('change', syncPicker);

  document.querySelector('form[action="/campaigns"]').addEventListener('submit', (e) => {
    const mode = selSelector.value;
    if (mode === 'ids' && !contactChecks().some((c) => c.checked)) {
      e.preventDefault();
      alert('Pilih minimal satu kontak untuk penerima.');
      return;
    }
    if (mode === 'tags' && !tagChecks().some((c) => c.checked)) {
      e.preventDefault();
      alert('Pilih minimal satu tag untuk penerima.');
      return;
    }
    syncPicker();
  });

  syncPicker();
  syncContactCount();

  const selRepeat = document.getElementById('sel-repeat');
  const repeatOpts = document.getElementById('repeat-opts');
  const untilLabel = document.getElementById('repeat-until-label');
  const syncRepeat = () => {
    const on = selRepeat.value === 'interval';
    repeatOpts.style.visibility = on ? 'visible' : 'hidden';
    untilLabel.style.display = on ? '' : 'none';
    repeatOpts.querySelectorAll('input, select').forEach((el) => { el.disabled = !on; });
    if (!on) untilLabel.querySelector('input').value = '';
  };
  selRepeat.addEventListener('change', syncRepeat);
  syncRepeat();
</script>

<%- include('partials/footer') %>
