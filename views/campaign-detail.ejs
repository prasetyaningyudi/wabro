<%- include('partials/header', { title: campaign.name, active: 'campaigns' }) %>

<% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %>
<% if (typeof excelResult !== 'undefined' && excelResult) { %>
  <div class="alert <%= (excelResult.errors.length || excelResult.skippedTotal) ? 'warn' : '' %>">
    Excel diproses: <strong><%= excelResult.added %></strong> penerima
    <% if (excelResult.duplicates) { %>, <strong><%= excelResult.duplicates %></strong> duplikat dilewati<% } %>
    <% if (excelResult.skippedTotal) { %>, <strong><%= excelResult.skippedTotal %></strong> baris terlewat (jadwal lampau/kosong)<% } %>.
    <% if (excelResult.skippedTotal) { %>
      <details><summary>daftar baris terlewat</summary>
        <ul><% excelResult.skipped.forEach(e => { %><li><%= e.message %></li><% }) %></ul>
        <% if (excelResult.skippedTotal > excelResult.skipped.length) { %>
          <div>…dan <%= excelResult.skippedTotal - excelResult.skipped.length %> baris lainnya</div>
        <% } %>
      </details>
    <% } %>
    <% if (excelResult.errors.length) { %>
      <details><summary><%= excelResult.errors.length %> baris dilewati</summary>
        <ul><% excelResult.errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </details>
    <% } %>
  </div>
<% } %>
<% if (typeof syncResult !== 'undefined' && syncResult) { %>
  <div class="alert <%= (syncResult.errors.length || syncResult.skippedTotal) ? 'warn' : '' %>">
    Sinkron: <strong><%= syncResult.added %></strong> baris baru
    <% if (syncResult.duplicates) { %>, <strong><%= syncResult.duplicates %></strong> sudah ada/duplikat<% } %>
    <% if (syncResult.skippedTotal) { %>, <strong><%= syncResult.skippedTotal %></strong> baris terlewat (jadwal lampau/kosong)<% } %>.
    <% if (syncResult.resumed) { %>Campaign dijadwalkan ulang untuk baris baru.<% } %>
    <% if (syncResult.skippedTotal) { %>
      <details><summary>daftar baris terlewat</summary>
        <ul><% syncResult.skipped.forEach(e => { %><li><%= e.message %></li><% }) %></ul>
        <% if (syncResult.skippedTotal > syncResult.skipped.length) { %>
          <div>…dan <%= syncResult.skippedTotal - syncResult.skipped.length %> baris lainnya</div>
        <% } %>
      </details>
    <% } %>
    <% if (syncResult.errors.length) { %>
      <details><summary><%= syncResult.errors.length %> baris dilewati</summary>
        <ul><% syncResult.errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </details>
    <% } %>
  </div>
<% } %>

<div class="card" id="camp-card" data-id="<%= campaign.id %>" data-status="<%= campaign.status %>">
  <div class="card-head">
    <h2><%= campaign.name %></h2>
    <span class="badge st-<%= campaign.status %>" id="camp-badge"><%= campaign.status %></span>
  </div>

  <div class="grid stats small">
    <div class="card stat"><span class="num" id="st-total"><%= stats.total %></span><span class="lbl">Total</span></div>
    <div class="card stat"><span class="num" id="st-pending"><%= stats.pending %></span><span class="lbl">Pending</span></div>
    <div class="card stat"><span class="num" id="st-sent"><%= stats.sent %></span><span class="lbl">Terkirim</span></div>
    <div class="card stat"><span class="num" id="st-delivered"><%= stats.delivered %></span><span class="lbl">Diterima</span></div>
    <div class="card stat"><span class="num" id="st-read"><%= stats.read %></span><span class="lbl">Dibaca</span></div>
    <div class="card stat <%= stats.failed ? 'bad' : '' %>"><span class="num" id="st-failed"><%= stats.failed %></span><span class="lbl">Gagal</span></div>
  </div>

  <div class="progress"><div class="bar" id="prog-bar"></div></div>
  <p class="muted" id="prog-text"></p>

  <p class="preview"><%= campaign.body %></p>
  <p class="muted">Variabel <code>{tanggal}</code> <code>{jam}</code> dst. dihitung ulang saat pesan dikirim.</p>
  <p class="muted">
    Delay: <%= campaign.delay_min_ms %>–<%= campaign.delay_max_ms %> ms ·
    <%= campaign.scheduled_at ? 'Jadwal: ' + new Date(campaign.scheduled_at).toLocaleString('id-ID') : 'Manual' %>
  </p>
  <% const rLabel = repeatLabel(campaign); %>
  <% if (rLabel) { %>
    <p class="muted">
      Pengulangan: <strong><%= rLabel %></strong> ·
      Siklus ke-<%= campaign.cycle_count + 1 %>
      <% if (campaign.last_run_at) { %> · Terakhir: <%= new Date(campaign.last_run_at).toLocaleString('id-ID') %><% } %>
    </p>
  <% } %>

  <% if (campaign.source_url) { %>
    <p class="muted">
      Sumber: <a href="<%= campaign.source_url %>" target="_blank" rel="noopener">sheet online</a> ·
      Terakhir sinkron: <%= campaign.last_sync_at ? new Date(campaign.last_sync_at).toLocaleString('id-ID') : 'belum pernah' %>
    </p>
  <% } %>

  <div class="row-gap">
    <% if (campaign.source_url) { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/sync" class="inline">
        <button class="btn primary">Sinkronkan ulang</button>
      </form>
    <% } %>
    <% if (['draft', 'paused', 'scheduled'].includes(campaign.status)) { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline">
        <button class="btn primary" name="action" value="start" <%= waConnected ? '' : 'disabled' %>>Jalankan</button>
      </form>
    <% } %>
    <% if (campaign.status === 'running') { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline">
        <button class="btn ghost" name="action" value="pause">Jeda</button>
      </form>
    <% } %>
    <% if (['draft', 'scheduled', 'running', 'paused'].includes(campaign.status)) { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline" onsubmit="return confirm('Batalkan campaign? Sisa pesan tidak terkirim.')">
        <button class="btn danger ghost" name="action" value="cancel">Batalkan</button>
      </form>
    <% } %>
    <a class="btn ghost" href="/campaigns/<%= campaign.id %>/export">Export CSV</a>
    <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline" onsubmit="return confirm('Hapus campaign beserta laporannya?')">
      <button class="btn danger ghost" name="action" value="delete">Hapus</button>
    </form>
    <a class="btn ghost" href="/campaigns">Kembali</a>
  </div>
</div>

<div class="card">
  <div class="card-head"><h2>Penerima (<%= total %>)</h2></div>
  <form method="GET" action="/campaigns/<%= campaign.id %>" class="filter-row">
    <input type="text" name="q" value="<%= q %>" placeholder="Cari nomor/nama…">
    <select name="status">
      <option value="">Semua status</option>
      <% ['pending','sending','sent','delivered','read','failed'].forEach(s => { %>
        <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <button class="btn ghost small">Filter</button>
  </form>
  <table>
    <thead><tr><th>Nomor</th><th>Nama</th><th>Jadwal</th><th>Status</th><th>Error</th><th>Waktu</th></tr></thead>
    <tbody id="recip-body">
      <% recipients.forEach(r => { %>
        <tr data-phone="<%= r.phone %>">
          <td><code><%= r.phone %></code></td>
          <td><%= r.name || '-' %></td>
          <td><%= r.scheduled_at ? new Date(r.scheduled_at).toLocaleString('id-ID') : '-' %></td>
          <td><span class="badge st-<%= r.status %>"><%= r.status %></span></td>
          <td class="truncate"><%= r.error || '' %></td>
          <td><%= r.sent_at ? new Date(r.sent_at).toLocaleTimeString('id-ID') : '-' %></td>
        </tr>
      <% }) %>
      <% if (!recipients.length) { %><tr><td colspan="6" class="muted">Tidak ada data.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer', { pageScript: 'campaign-detail' }) %>
