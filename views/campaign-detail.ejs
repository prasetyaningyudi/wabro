<%- include('partials/header', { title: campaign.name, active: 'campaigns' }) %>

<% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert ok"><%= notice %></div><% } %>
<% if (typeof excelResult !== 'undefined' && excelResult) { %>
  <div class="alert <%= (excelResult.errors.length || excelResult.skippedTotal) ? 'warn' : '' %>">
    Excel diproses: <strong><%= excelResult.added %></strong> penerima
    <% if (excelResult.duplicates) { %>, <strong><%= excelResult.duplicates %></strong> duplikat dilewati<% } %>
    <% if (excelResult.skippedTotal) { %>, <strong><%= excelResult.skippedTotal %></strong> baris terlewat (jadwal lampau/kosong)<% } %>.
    <% if (excelResult.skippedTotal) { %>
      <details><summary>daftar baris terlewat</summary>
        <ul><% excelResult.skipped.forEach(e => { %><li><%= e.message %></li><% }) %></ul>
        <% if (excelResult.skippedTotal > excelResult.skipped.length) { %>
          <div>…dan <%= excelResult.skippedTotal - excelResult.skipped.length %> baris lainnya</div>
        <% } %>
      </details>
    <% } %>
    <% if (excelResult.errors.length) { %>
      <details><summary><%= excelResult.errors.length %> baris dengan masalah</summary>
        <ul><% excelResult.errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </details>
    <% } %>
  </div>
<% } %>
<% if (typeof syncResult !== 'undefined' && syncResult) { %>
  <div class="alert <%= (syncResult.errors.length || syncResult.skippedTotal) ? 'warn' : '' %>">
    Sinkron: <strong><%= syncResult.added %></strong> baris baru
    <% if (syncResult.updated) { %>, <strong><%= syncResult.updated %></strong> baris diperbarui (jadwal/pesan baru, siap dikirim)<% } %>
    <% if (syncResult.duplicates) { %>, <strong><%= syncResult.duplicates %></strong> sudah ada/duplikat<% } %>
    <% if (syncResult.skippedTotal) { %>, <strong><%= syncResult.skippedTotal %></strong> baris terlewat (jadwal lampau/kosong)<% } %>.
    <% if (syncResult.resumed) { %>Campaign dijadwalkan ulang untuk baris baru.<% } %>
    <% if (syncResult.skippedTotal) { %>
      <details><summary>daftar baris terlewat</summary>
        <ul><% syncResult.skipped.forEach(e => { %><li><%= e.message %></li><% }) %></ul>
        <% if (syncResult.skippedTotal > syncResult.skipped.length) { %>
          <div>…dan <%= syncResult.skippedTotal - syncResult.skipped.length %> baris lainnya</div>
        <% } %>
      </details>
    <% } %>
    <% if (syncResult.errors.length) { %>
      <details><summary><%= syncResult.errors.length %> baris dengan masalah</summary>
        <ul><% syncResult.errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </details>
    <% } %>
  </div>
<% } %>
<% if ((!syncResult && !excelResult) && typeof lastProcess !== 'undefined' && lastProcess) { %>
  <div class="alert <%= (lastProcess.errors?.length || lastProcess.skippedTotal) ? 'warn' : '' %>">
    <%= lastProcess.kind === 'sync' ? 'Hasil sinkron terakhir' : 'Hasil impor terakhir' %>
    (<%= new Date(lastProcess.at).toLocaleString('id-ID') %>):
    <% if (lastProcess.added) { %><strong><%= lastProcess.added %></strong> baris baru<% } else { %>0 baris baru<% } %>
    <% if (lastProcess.updated) { %>, <strong><%= lastProcess.updated %></strong> diperbarui<% } %>
    <% if (lastProcess.duplicates) { %>, <strong><%= lastProcess.duplicates %></strong> duplikat<% } %>
    <% if (lastProcess.skippedTotal) { %>, <strong><%= lastProcess.skippedTotal %></strong> terlewat (jadwal lampau/kosong)<% } %>.
    <% if (lastProcess.resumed) { %>Campaign dijadwalkan ulang untuk baris baru.<% } %>
    <% if (lastProcess.pulledForward) { %>Jadwal campaign ditarik ke baris paling awal.<% } %>
    <% if (lastProcess.skipped?.length) { %>
      <details><summary>daftar baris terlewat</summary>
        <ul><% lastProcess.skipped.forEach(e => { %><li><%= e.message %></li><% }) %></ul>
        <% if (lastProcess.skippedTotal > lastProcess.skipped.length) { %>
          <div>…dan <%= lastProcess.skippedTotal - lastProcess.skipped.length %> baris lainnya</div>
        <% } %>
      </details>
    <% } %>
    <% if (lastProcess.errors?.length) { %>
      <details open><summary><%= lastProcess.errors.length %> baris dengan masalah (error)</summary>
        <ul><% lastProcess.errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </details>
    <% } %>
  </div>
<% } %>

<div class="card" id="camp-card" data-id="<%= campaign.id %>" data-status="<%= campaign.status %>">
  <div class="card-head">
    <h2><%= campaign.name %></h2>
    <span class="badge st-<%= campaign.status %>" id="camp-badge"><%= campaign.status %></span>
  </div>

  <div class="grid stats small">
    <div class="card stat"><span class="num" id="st-total"><%= stats.total %></span><span class="lbl">Total</span></div>
    <div class="card stat"><span class="num" id="st-pending"><%= stats.pending %></span><span class="lbl">Pending</span></div>
    <div class="card stat"><span class="num" id="st-sent"><%= stats.sent %></span><span class="lbl">Terkirim</span></div>
    <div class="card stat"><span class="num" id="st-delivered"><%= stats.delivered %></span><span class="lbl">Diterima</span></div>
    <div class="card stat"><span class="num" id="st-read"><%= stats.read %></span><span class="lbl">Dibaca</span></div>
    <div class="card stat <%= stats.failed ? 'bad' : '' %>"><span class="num" id="st-failed"><%= stats.failed %></span><span class="lbl">Gagal</span></div>
    <div class="card stat"><span class="num" id="st-skipped"><%= stats.skipped || 0 %></span><span class="lbl">Dilewati</span></div>
  </div>

  <div class="progress"><div class="bar" id="prog-bar"></div></div>
  <p class="muted" id="prog-text"></p>

  <p class="preview"><%= campaign.body %></p>
  <p class="muted">Variabel <code>{tanggal}</code> <code>{jam}</code> dst. dihitung ulang saat pesan dikirim.</p>
  <p class="muted">
    Delay: <%= campaign.delay_min_ms %>–<%= campaign.delay_max_ms %> ms ·
    <%= campaign.scheduled_at ? 'Jadwal: ' + new Date(campaign.scheduled_at).toLocaleString('id-ID') : 'Manual' %>
  </p>
  <% const rLabel = repeatLabel(campaign); %>
  <% if (rLabel) { %>
    <p class="muted">
      Pengulangan: <strong><%= rLabel %></strong> ·
      Siklus ke-<%= campaign.cycle_count + 1 %>
      <% if (campaign.last_run_at) { %> · Terakhir: <%= new Date(campaign.last_run_at).toLocaleString('id-ID') %><% } %>
    </p>
  <% } %>

  <% if (campaign.source_url) { %>
    <p class="muted">
      Excel online: <a class="src-url" href="<%= campaign.source_url %>" target="_blank" rel="noopener"><%= campaign.source_url %></a> ·
      Terakhir sinkron: <%= campaign.last_sync_at ? new Date(campaign.last_sync_at).toLocaleString('id-ID') : 'belum pernah' %>
    </p>
  <% } %>

  <div class="row-gap">
    <% if (campaign.source_url) { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/sync" class="inline">
        <button class="btn primary">Sinkronkan ulang</button>
      </form>
      <form method="POST" action="/campaigns/<%= campaign.id %>/auto-sync" class="inline" id="auto-sync-form" title="Sinkron otomatis tanpa klik — hasilnya sama dengan Sinkronkan ulang">
        <select name="mode">
          <option value="off" <%= autoSyncRule ? '' : 'selected' %>>Sinkron otomatis: Mati</option>
          <option value="i" <%= autoSyncRule && autoSyncRule.t === 'i' ? 'selected' : '' %>>Setiap (interval)</option>
          <option value="d" <%= autoSyncRule && autoSyncRule.t === 'd' ? 'selected' : '' %>>Setiap hari</option>
          <option value="w" <%= autoSyncRule && autoSyncRule.t === 'w' ? 'selected' : '' %>>Setiap minggu</option>
        </select>
        <select name="minutes" class="as-i">
          <% autoSyncOptions.forEach(o => { %>
            <option value="<%= o.m %>" <%= autoSyncRule && autoSyncRule.t === 'i' && autoSyncRule.m === o.m ? 'selected' : '' %>><%= o.label.charAt(0).toUpperCase() + o.label.slice(1) %></option>
          <% }) %>
        </select>
        <select name="day" class="as-w">
          <option value="1" <%= autoSyncRule && autoSyncRule.t === 'w' && autoSyncRule.d === 1 ? 'selected' : '' %>>Senin</option>
          <option value="2" <%= autoSyncRule && autoSyncRule.t === 'w' && autoSyncRule.d === 2 ? 'selected' : '' %>>Selasa</option>
          <option value="3" <%= autoSyncRule && autoSyncRule.t === 'w' && autoSyncRule.d === 3 ? 'selected' : '' %>>Rabu</option>
          <option value="4" <%= autoSyncRule && autoSyncRule.t === 'w' && autoSyncRule.d === 4 ? 'selected' : '' %>>Kamis</option>
          <option value="5" <%= autoSyncRule && autoSyncRule.t === 'w' && autoSyncRule.d === 5 ? 'selected' : '' %>>Jumat</option>
          <option value="6" <%= autoSyncRule && autoSyncRule.t === 'w' && autoSyncRule.d === 6 ? 'selected' : '' %>>Sabtu</option>
          <option value="0" <%= autoSyncRule && autoSyncRule.t === 'w' && autoSyncRule.d === 0 ? 'selected' : '' %>>Minggu</option>
        </select>
        <input type="time" name="clock" class="as-dw" value="<%= autoSyncRule && autoSyncRule.t !== 'i' ? String(autoSyncRule.h).padStart(2, '0') + ':' + String(autoSyncRule.mi).padStart(2, '0') : '08:00' %>">
        <button class="btn ghost small" title="Simpan pengaturan sinkron otomatis">Simpan Auto</button>
      </form>
    <% } %>
    <% if (['draft', 'paused', 'scheduled'].includes(campaign.status)) { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline">
        <button class="btn primary" name="action" value="start" <%= waConnected ? '' : 'disabled' %>>Jalankan</button>
      </form>
    <% } %>
    <% if (campaign.status === 'running') { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline">
        <button class="btn ghost" name="action" value="pause">Jeda</button>
      </form>
    <% } %>
    <% if (['draft', 'scheduled', 'running', 'paused'].includes(campaign.status)) { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline" onsubmit="return confirm('Batalkan campaign? Sisa pesan tidak terkirim.')">
        <button class="btn danger ghost" name="action" value="cancel">Batalkan</button>
      </form>
    <% } %>
    <% if (stats.failed > 0 && campaign.status !== 'cancelled') { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline" onsubmit="return confirm('Jadwalkan ulang <%= stats.failed %> penerima gagal untuk dikirim kembali?')">
        <button class="btn ghost" name="action" value="retry" title="Kembalikan penerima gagal ke antrean kirim">Ulangi gagal (<%= stats.failed %>)</button>
      </form>
    <% } %>
    <% if (campaign.status === 'completed' && !campaign.source_url) { %>
      <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline" onsubmit="return confirm('Jalankan ulang campaign? Penerima yang tidak dilewati akan dikirim pesan lagi.')">
        <button class="btn ghost" name="action" value="rerun" title="Kirim ulang ke semua penerima" <%= waConnected ? '' : 'disabled' %>>Jalankan ulang</button>
      </form>
    <% } %>
    <a class="btn ghost" href="/campaigns/<%= campaign.id %>/export">Export CSV</a>
    <form method="POST" action="/campaigns/<%= campaign.id %>/action" class="inline" onsubmit="return confirm('Hapus campaign beserta laporannya?')">
      <button class="btn danger ghost" name="action" value="delete">Hapus</button>
    </form>
    <a class="btn ghost" href="/campaigns">Kembali</a>
  </div>
</div>

<div class="card">
  <div class="card-head"><h2>Penerima (<%= total %>)</h2></div>
  <form method="GET" action="/campaigns/<%= campaign.id %>" class="filter-row">
    <input type="text" name="q" value="<%= q %>" placeholder="Cari nomor/nama…">
    <select name="status">
      <option value="">Semua status</option>
      <% ['pending','sending','sent','delivered','read','failed','skipped'].forEach(s => { %>
        <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <button class="btn ghost small">Filter</button>
  </form>
  <table>
    <thead><tr><th>Nomor</th><th>Nama</th><th>Jadwal</th><th>Status</th><th>Error</th><th>Waktu</th><th>Aksi</th></tr></thead>
    <tbody id="recip-body">
      <% recipients.forEach(r => { %>
        <tr data-phone="<%= r.phone %>">
          <td><code><%= r.phone %></code></td>
          <td><%= r.name || '-' %></td>
          <td><%= r.scheduled_at ? new Date(r.scheduled_at).toLocaleString('id-ID') : '-' %></td>
          <td><span class="badge st-<%= r.status %>"><%= r.status %></span></td>
          <td class="truncate"><%= r.error || '' %></td>
          <td><%= r.sent_at ? new Date(r.sent_at).toLocaleTimeString('id-ID') : '-' %></td>
          <td>
            <% if (r.status === 'pending') { %>
              <form method="POST" action="/campaigns/<%= campaign.id %>/recipient" class="inline" onsubmit="return confirm('Lewati baris ini? Nomor tersebut tidak akan dikirim.')">
                <input type="hidden" name="rid" value="<%= r.id %>">
                <button class="btn ghost small" name="raction" value="skip" title="Jangan kirim baris ini">Lewati</button>
              </form>
            <% } else if (r.status === 'skipped') { %>
              <form method="POST" action="/campaigns/<%= campaign.id %>/recipient" class="inline" onsubmit="return confirm('Aktifkan kembali baris ini? Akan masuk antrean kirim lagi.')">
                <input type="hidden" name="rid" value="<%= r.id %>">
                <button class="btn ghost small" name="raction" value="resend" title="Kembalikan ke antrean kirim">Aktifkan</button>
              </form>
            <% } else if (['failed', 'sent', 'delivered', 'read'].includes(r.status)) { %>
              <form method="POST" action="/campaigns/<%= campaign.id %>/recipient" class="inline" onsubmit="return confirm('Kirim ulang baris ini?')">
                <input type="hidden" name="rid" value="<%= r.id %>">
                <button class="btn ghost small" name="raction" value="resend" title="Kirim ulang baris ini">Kirim ulang</button>
              </form>
            <% } else { %>
              -
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!recipients.length) { %><tr><td colspan="7" class="muted">Tidak ada data.</td></tr><% } %>
    </tbody>
  </table>
  <% if (pages > 1) { %>
    <div class="row-gap" style="justify-content:space-between;padding-top:8px">
      <span class="muted">Halaman <%= page %> dari <%= pages %> — menampilkan <%= recipients.length %> dari <%= total %> penerima</span>
      <span class="row-gap">
        <% const pageUrl = (p) => `/campaigns/${campaign.id}?status=${encodeURIComponent(statusFilter)}&q=${encodeURIComponent(q)}&page=${p}`; %>
        <% if (page > 1) { %><a class="btn ghost small" href="<%= pageUrl(page - 1) %>">Sebelumnya</a><% } %>
        <% if (page < pages) { %><a class="btn ghost small" href="<%= pageUrl(page + 1) %>">Berikutnya</a><% } %>
      </span>
    </div>
  <% } %>
</div>

<%- include('partials/footer', { pageScript: 'campaign-detail' }) %>
