# Port web panel
PORT=3200

# Password login panel (WAJIB diubah)
ADMIN_PASSWORD=admin123

# Secret untuk session cookie (WAJIB diubah, bebas string acak)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Aktifkan kalau di belakang reverse proxy HTTPS (mis. Caddy/Nginx di ZimaOS)
# Agar cookie secure bekerja, isi jumlah hop proxy: 1
# TRUST_PROXY=1

# Zona waktu server (jadwal Excel & variabel {jam} mengikuti zona ini).
# Default aplikasi WIB; di Docker sudah di-set Asia/Jakarta.
# TZ=Asia/Jakarta
